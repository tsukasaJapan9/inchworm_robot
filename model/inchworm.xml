<mujoco model="inchworm">
	<!-- optionはシミュレーション全体の設定。timestepや積分方法を指定する -->
	<!-- noslip_iterationsが無いとfrictionlossが作用しない -->
	<option timestep="0.001" integrator="implicitfast" noslip_iterations="10" />

	<!-- defaultは以降のgeomなどに共通で適用される既定値をまとめる場所 -->
	<default>
		<!-- frictionはgeom同士が触れたときの摩擦。今回は足と床のあいだに作用する -->
		<!-- 3つの数字は順に滑り・ねじれ・転がり。既定値の1 0.005 0.0001から滑りだけ下げた -->
		<geom friction="0.3 0.005 0.0001" />
	</default>

	<!-- 節ごとに色を変えておくと、ビューアで前後の区別がつく -->
	<asset>
		<texture name="grid" type="2d" builtin="checker"
			rgb1="0.3 0.3 0.3" rgb2="0.4 0.4 0.4" width="300" height="300" />
		<material name="grid" texture="grid" texrepeat="10 10" />
		<material name="m_mid" rgba="0.25 0.45 0.85 1" />
		<material name="m_front" rgba="0.90 0.50 0.18 1" />
		<material name="m_rear" rgba="0.25 0.65 0.38 1" />
	</asset>

	<worldbody>
		<light pos="0.4 -0.5 0.9" dir="-0.3 0.4 -1" directional="true" />
		<geom name="floor" type="plane" size="3 3 0.1" material="grid" />

		<!-- 中の節。このbodyの中に前後の節を入れ子にする -->
		<body name="mid" pos="0 0 0.018">
			<freejoint />
			<!-- inertialは質量と慣性モーメント。省くとgeomの形から自動計算される -->
			<!-- diaginertiaはx・y・z軸まわりの回しにくさ。直方体とみなして計算した -->
			<inertial pos="0 0 0" mass="0.1796"
				diaginertia="6.97e-05 2.50e-04 2.80e-04" />
			<geom name="mid_box" type="box" size="0.062 0.029 0.018" material="m_mid" />
			<!-- siteは座標だけを持つ目印。シミュレーション結果には影響せず、IMUの取り付け位置に使う -->
			<site name="imu" pos="0 0 0.018" />

			<!-- 前の節。posは親（中の節）から見た位置 -->
			<body name="front" pos="0.062 0 0.001">
				<!-- jointは関節。hingeは1軸の回転で、axisが回転軸の向き -->
				<!-- axisを前後で反転させ、どちらも「プラス＝先端が持ち上がる」に揃える -->
				<!-- frictionlossは関節そのものの摩擦。減速ギアが回るときの抵抗にあたる（既定値は0） -->
				<!-- dampingは関節の速度に比例してかかる抵抗。速く動くほど強く止めようとする -->
				<!-- armatureはモータ内部で回る部品の慣性。減速ギアを介すと関節側から大きく見える -->
				<joint name="J1" type="hinge" axis="0 -1 0" range="-90 90"
					damping="0.002" armature="0.0005" frictionloss="0.03" />
				<inertial pos="0.035 0 -0.001" mass="0.0468"
					diaginertia="2.36e-05 2.14e-05 4.05e-05" />
				<geom name="front_box" type="box" pos="0.029 0 -0.001"
					size="0.029 0.037 0.012" material="m_front" />
				<!-- 床に触れるのはこの丸い先端だけ -->
				<geom name="front_tip" type="cylinder" pos="0.058 0 -0.001"
					size="0.012 0.037" zaxis="0 1 0" material="m_front" />
			</body>

			<!-- 後の節。前の節とxの符号、axisを反転させた同じ形 -->
			<body name="rear" pos="-0.062 0 0.001">
				<joint name="J2" type="hinge" axis="0 1 0" range="-90 90"
					damping="0.002" armature="0.0005" frictionloss="0.03" />
				<inertial pos="-0.035 0 -0.001" mass="0.0468"
					diaginertia="2.36e-05 2.14e-05 4.05e-05" />
				<geom name="rear_box" type="box" pos="-0.029 0 -0.001"
					size="0.029 0.037 0.012" material="m_rear" />
				<geom name="rear_tip" type="cylinder" pos="-0.058 0 -0.001"
					size="0.012 0.037" zaxis="0 1 0" material="m_rear" />
			</body>
		</body>
	</worldbody>

	<!-- motorはアクチュエータの1種。ctrlrangeの範囲でトルクを関節へ加える -->
	<!-- 0.52N·mはXL330-M288-Tの失速トルク。実機が出せる以上は出さない -->
	<actuator>
		<motor name="J1" joint="J1" ctrlrange="-0.52 0.52" />
		<motor name="J2" joint="J2" ctrlrange="-0.52 0.52" />
	</actuator>

	<!-- センサは実機に合わせて3つ。IMUの角速度と、サーボから読める関節角 -->
	<sensor>
		<gyro name="gyro" site="imu" />
		<jointpos name="q1" joint="J1" />
		<jointpos name="q2" joint="J2" />
	</sensor>
</mujoco>
